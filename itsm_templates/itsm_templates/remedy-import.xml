<?xml version="1.0" encoding="UTF-8"?>
<ARXform xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <form name="Feature Request" type="custom">
        <schema>HPD:Help Desk</schema>
        <default_fields>
            <field name="Status" value="New"/>
            <field name="Priority" value="${priority}"/>
            <field name="Impact" value="${impact}"/>
            <field name="Urgency" value="${urgency}"/>
            <field name="Reported Source" value="DevSecOps"/>
            <field name="Service Type" value="Infrastructure"/>
        </default_fields>
        <custom_fields>
            <field name="z1D_SecurityReviewRequired" value="Yes"/>
            <field name="z1D_ComplianceFrameworks" value="SOX,GDPR,HIPAA,PCI"/>
            <field name="z1D_DataClassification" value="Confidential"/>
            <field name="z1D_DevTeam" value="${dev_team}"/>
        </custom_fields>
        <workflow>
            <stage name="Draft" role="Requester"/>
            <stage name="Security Review" role="Security_Team"/>
            <stage name="Development" role="Dev_Team"/>
            <stage name="Testing" role="QA_Team"/>
            <stage name="Deployment" role="Release_Team"/>
        </workflow>
    </form>

    <form name="Security Assessment" type="security">
        <schema>SEC:Security</schema>
        <default_fields>
            <field name="Status" value="New"/>
            <field name="Priority" value="${priority}"/>
            <field name="Risk Level" value="${risk}"/>
            <field name="Assignment" value="Security Team"/>
        </default_fields>
        <custom_fields>
            <field name="z1D_ComplianceScope" value="${compliance}"/>
            <field name="z1D_SecurityControls" value="${controls}"/>
            <field name="z1D_ThreatLevel" value="${threat_level}"/>
            <field name="z1D_DataImpact" value="${data_impact}"/>
        </custom_fields>
        <workflow>
            <stage name="Initiation" role="Requester"/>
            <stage name="Assessment" role="Security_Analyst"/>
            <stage name="Review" role="Security_Manager"/>
            <stage name="Remediation" role="Dev_Team"/>
            <stage name="Verification" role="Security_Team"/>
        </workflow>
    </form>

    <form name="Infrastructure Change" type="change">
        <schema>CHG:Infrastructure Change</schema>
        <default_fields>
            <field name="Status" value="Draft"/>
            <field name="Priority" value="${priority}"/>
            <field name="Risk Level" value="${risk}"/>
            <field name="Change Type" value="Normal"/>
            <field name="Category" value="Infrastructure"/>
        </default_fields>
        <custom_fields>
            <field name="z1D_ChangeWindow" value="${window}"/>
            <field name="z1D_Implementation" value="${implementation}"/>
            <field name="z1D_Rollback" value="${rollback}"/>
            <field name="z1D_Validation" value="${validation}"/>
        </custom_fields>
        <workflow>
            <stage name="Planning" role="Change_Manager"/>
            <stage name="Risk Assessment" role="Risk_Team"/>
            <stage name="CAB Review" role="CAB"/>
            <stage name="Implementation" role="Tech_Team"/>
            <stage name="Validation" role="QA_Team"/>
        </workflow>
    </form>

    <form name="Production Deployment" type="release">
        <schema>RLS:Release Management</schema>
        <default_fields>
            <field name="Status" value="Draft"/>
            <field name="Priority" value="${priority}"/>
            <field name="Release Type" value="Major"/>
            <field name="Category" value="Application"/>
        </default_fields>
        <custom_fields>
            <field name="z1D_DeploymentPlan" value="${deploy_plan}"/>
            <field name="z1D_BackoutPlan" value="${backout_plan}"/>
            <field name="z1D_TestStrategy" value="${test_strategy}"/>
            <field name="z1D_SecurityChecks" value="${security_checks}"/>
        </custom_fields>
        <workflow>
            <stage name="Planning" role="Release_Manager"/>
            <stage name="Security Review" role="Security_Team"/>
            <stage name="CAB Approval" role="CAB"/>
            <stage name="Deployment" role="Release_Team"/>
            <stage name="Verification" role="QA_Team"/>
        </workflow>
    </form>

    <form name="Incident Response" type="incident">
        <schema>HPD:Help Desk</schema>
        <default_fields>
            <field name="Status" value="New"/>
            <field name="Priority" value="${priority}"/>
            <field name="Impact" value="${impact}"/>
            <field name="Urgency" value="${urgency}"/>
            <field name="Incident Type" value="Major"/>
        </default_fields>
        <custom_fields>
            <field name="z1D_SecurityIncident" value="${is_security}"/>
            <field name="z1D_DataBreach" value="${is_breach}"/>
            <field name="z1D_NotificationReq" value="${notifications}"/>
            <field name="z1D_ContainmentSteps" value="${containment}"/>
        </custom_fields>
        <workflow>
            <stage name="Detection" role="Service_Desk"/>
            <stage name="Triage" role="Incident_Manager"/>
            <stage name="Investigation" role="Tech_Team"/>
            <stage name="Resolution" role="Support_Team"/>
            <stage name="Review" role="Problem_Manager"/>
        </workflow>
    </form>

    <notifications>
        <notification event="Security Review Required">
            <recipients>
                <group name="Security_Team"/>
                <role name="Security_Manager"/>
            </recipients>
            <template>
                <subject>Security Review Required: ${summary}</subject>
                <body>A security review is required for: ${description}</body>
            </template>
        </notification>
        <notification event="CAB Review Required">
            <recipients>
                <group name="Change_Advisory_Board"/>
                <role name="Change_Manager"/>
            </recipients>
            <template>
                <subject>CAB Review Required: ${summary}</subject>
                <body>CAB review is required for: ${description}</body>
            </template>
        </notification>
    </notifications>

    <sla_definitions>
        <sla name="Security Review SLA">
            <condition>Priority = 'High' AND SecurityReviewRequired = 'Yes'</condition>
            <response_time>4 hours</response_time>
            <resolution_time>24 hours</resolution_time>
        </sla>
        <sla name="Major Incident SLA">
            <condition>Priority = 'Critical' AND IncidentType = 'Major'</condition>
            <response_time>15 minutes</response_time>
            <resolution_time>4 hours</resolution_time>
        </sla>
    </sla_definitions>
</ARXform>
